# Configuración de Supabase (Base de datos en tiempo real)
# Obtén estas claves de forma 100% gratuita en https://supabase.com
# Proyecto -> Settings -> API -> Project URL & Project API Keys (anon public)

NEXT_PUBLIC_SUPABASE_URL=https://TU_PROYECTO_AQUI.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_clave_anonima_publica_aqui

# PIN de Administrador (para confirmar pagos y liberar números)
NEXT_PUBLIC_ADMIN_PIN=1234
